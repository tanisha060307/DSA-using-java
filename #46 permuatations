class Solution {
    public List<List<Integer>> permute(int[] nums) {
        List<List<Integer>> result = new ArrayList<>();
        f(nums,result,0);
        return result;
    }
    private void f(int[] nums, List<List<Integer>> result, int idx){
        if (idx==nums.length){
            List<Integer> perm = new ArrayList<>();
            for(int el:nums){
                perm.add(el);
            }
            result.add(perm);
            return;
        }
        for(int i=idx;i<nums.length;i++){
            swap(nums,i,idx);
            f(nums,result,idx+1);
            swap(nums,i,idx);
        }
    }
    private void swap(int[]nums,int i,int j){
        int temp = nums[i];
        nums[i]=nums[j];
        nums[j]=temp;
    }
}
