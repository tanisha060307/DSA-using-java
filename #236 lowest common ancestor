class Solution {
    public TreeNode lowestCommonAncestor(TreeNode root, TreeNode p, TreeNode q) {

        // If tree is empty, return null
        // OR if current node is p or q, we found one target
        if (root == null || root == p || root == q) {
            return root;
        }

        // Search for p or q in the left subtree
        TreeNode left = lowestCommonAncestor(root.left, p, q);

        // Search for p or q in the right subtree
        TreeNode right = lowestCommonAncestor(root.right, p, q);

        // If both sides found a target,
        // current root is their Lowest Common Ancestor
        if (left != null && right != null) {
            return root;
        }

        // If only left side found something,
        // return that left result
        if (left != null) {
            return left;
        }

        // Otherwise return the right result
        return right;
    }
}
