class Solution {
    public int minDepth(TreeNode root) {

        // Empty tree
        if (root == null) {
            return 0;
        }

        // No left child
        if (root.left == null) {
            return 1 + minDepth(root.right);
        }

        // No right child
        if (root.right == null) {
            return 1 + minDepth(root.left);
        }

        // Both children exist
        return 1 + Math.min(
            minDepth(root.left),
            minDepth(root.right)
        );
    }
}
